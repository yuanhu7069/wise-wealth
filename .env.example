# 智策理财 · 环境变量模板（只含键名与占位符，真实值填在 .env，.env 禁止提交 Git）

APP_ENV=dev
APP_PORT=8080

# 口令含特殊字符时必须 URL 编码（如 # → %23）
DATABASE_URL_DEV=postgres://<用户>:<密码>@<主机>:5432/<库名>
DATABASE_URL_PROD=postgres://<用户>:<密码>@<主机>:5432/<正式库名>

API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_APP_VERSION=
RUST_LOG=info

# ── B 期新增 ──
# 会话签名密钥:至少 32 字符,随机生成(如 openssl rand -base64 32)
JWT_SECRET=<至少 32 字符的随机串>
# 会话有效期(天),缺省 30
SESSION_TTL_DAYS=30
# 种子账号(仅 seed-user 子命令消费;无注册页,忘记口令即重跑种子脚本)
SEED_USERNAME=<用户名>
SEED_PASSWORD=<口令>

# ── E 期新增 ──
# 偏离提醒阈值(万分比,2000 = 20%);范围 1..=10000,改后重启生效(ADR-E-003,不进 UI)
SNAPSHOT_DEVIATION_THRESHOLD_BP=2000
