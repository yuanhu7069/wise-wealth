{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, to_char(s.month, 'YYYY-MM') AS \"month!\", s.plan_id, s.balances,\n               s.special_month AS \"special_month!\", p.version AS \"plan_version!\"\n        FROM snapshots s JOIN plans p ON p.id = s.plan_id\n        WHERE s.user_id = $1\n        ORDER BY s.month DESC\n        LIMIT $2 OFFSET $3\n        ",
