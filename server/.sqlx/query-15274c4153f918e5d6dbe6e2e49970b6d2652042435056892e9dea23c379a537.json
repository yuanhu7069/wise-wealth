{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, to_char(month, 'YYYY-MM') AS \"month!\", plan_id, balances, special_month\n        FROM snapshots\n        WHERE user_id = $1\n          AND month < to_date($2 || '-01', 'YYYY-MM-DD')\n          AND NOT special_month\n        ORDER BY month DESC LIMIT 1\n        ",
