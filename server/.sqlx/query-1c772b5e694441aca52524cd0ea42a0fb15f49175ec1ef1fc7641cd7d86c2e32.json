  "query": "\n            INSERT INTO snapshots (id, user_id, plan_id, month, balances, special_month)\n            VALUES ($1, $2, $3, to_date($4 || '-01', 'YYYY-MM-DD'), $5, $6)\n            RETURNING id, to_char(month, 'YYYY-MM') AS \"month!\", plan_id, balances, special_month\n            ",
